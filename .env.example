# DoraMCU Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
DB_PASSWORD=change-me-to-a-secure-password

# JWT Configuration (REQUIRED for production)
# Must be at least 32 characters for HMAC-SHA256
JWT_SECRET=change-me-to-a-random-64-character-string

# Application Server
SERVER_PORT=8080

# Database Host (for Docker)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=doramcu
DB_USERNAME=root

# AI Service Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Deep Learning Configuration (Optional)
DL_BLEND_FACTOR=0.7

# Game Session Configuration
GAMESESSION_TTL_HOURS=24

# Seed Data (dev only - do NOT enable in production)
# APP_SEED_DATA=true
