<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Import Spring Boot defaults -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <!-- Production JSON logging profile -->
    <springProfile name="prod">
        <!-- JSON console appender for log aggregation (ELK, Grafana Loki, etc.) -->
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Include correlation ID from MDC -->
                <customFields>{"app":"DoraMCU"}</customFields>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeCallerData>false</includeCallerData>
                <includeRootCauseId>false</includeRootCauseId>
                <includeStackTrace>false</includeStackTrace>
                <includeCodeLookup>false</includeCodeLookup>
                <includeLoggingEventUsername>false</includeLoggingEventUsername>
                <includeLogLevel>false</includeLogLevel>
                <includeMarker>true</includeMarker>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <mdcIncludePattern>.*</mdcIncludePattern>
            </encoder>
        </appender>

        <!-- JSON file appender for log aggregation -->
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE:-logs/doramcu.log}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE:-logs/doramcu.log}.%d{yyyy-MM-dd}.%i</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>5</maxHistory>
                <totalSizeCap>50MB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"DoraMCU"}</customFields>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeCallerData>false</includeCallerData>
                <includeRootCauseId>false</includeRootCauseId>
                <includeStackTrace>false</includeStackTrace>
                <includeCodeLookup>false</includeCodeLookup>
                <includeLoggingEventUsername>false</includeLoggingEventUsername>
                <includeLogLevel>false</includeLogLevel>
                <includeMarker>true</includeMarker>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <mdcIncludePattern>.*</mdcIncludePattern>
            </encoder>
        </appender>

        <!-- Root logger uses JSON appenders in production -->
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>

        <!-- Application logs at INFO in production -->
        <logger name="com.yisy.modules.doramcu" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.flywaydb" level="INFO"/>
    </springProfile>

    <!-- Dev profile uses default Spring Boot pattern (human-readable) -->
    <springProfile name="dev,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- Application logs at DEBUG in dev -->
        <logger name="com.yisy.modules.doramcu" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate" level="INFO"/>
        <logger name="org.flywaydb" level="INFO"/>
    </springProfile>
</configuration>
